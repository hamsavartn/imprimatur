# --- Database (Neon or local Postgres) ---
# Local dev:  postgres://postgres:postgres@localhost:5432/imprimatur
# Neon:       postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Models ---
# Google AI Studio free key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Paid fallback (Z.ai open platform)
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# Set to "true" to force confidential mode: no external model calls at all,
# the deterministic lane runs alone and grounding findings are skipped.
CONFIDENTIAL_MODE=false
